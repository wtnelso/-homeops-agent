{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserProfile",
  "type": "object",
  "properties": {
    "members": {
      "type": "array",
      "items": { "$ref": "#/definitions/Member" }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "schools": { "type": "array", "items": { "$ref": "#/definitions/Contact" } },
        "services": { "type": "array", "items": { "$ref": "#/definitions/Contact" } },
        "healthcare": { "type": "array", "items": { "$ref": "#/definitions/Contact" } }
      }
    },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "schedule": { "type": "string" },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/definitions/Activity" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Important keywords for AI agent to detect relevant information in emails and conversations"
    }
  },
  "required": ["members", "contacts", "metadata"],

  "definitions": {
    "Member": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "age": { "type": "integer" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["user", "partner", "child", "other"] },
        "user": { "type": "boolean" },
        "email": { "type": "string", "format": "email" },
        "schools": { "type": "array", "items": { "$ref": "#/definitions/School" } },
        "birthday": { "$ref": "#/definitions/Birthday" },
        "activities": { "type": "array", "items": { "$ref": "#/definitions/Activity" } }
      },
      "required": ["id", "name", "type"]
    },

    "School": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "grade": { "type": "string" },
        "source": { "$ref": "#/definitions/Source" },
        "email_domain": { "type": "string" }
      }
    },

    "Activity": {
      "type": "object",
      "properties": {
        "days": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "source": { "$ref": "#/definitions/Source" },
        "end_date": { "type": "string" },
        "frequency": { "type": "string" }
      },
      "required": ["name", "type"]
    },

    "Source": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "source_id": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number" },
        "updated_at": { "type": "string", "format": "date-time" },
        "original_text": { "type": ["string", "null"] },
        "email_subject": { "type": "string" }
      }
    },

    "Contact": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "source": { "$ref": "#/definitions/Source" },
        "address": { "type": "string" },
        "relationship": { "type": "string" }
      }
    },

    "Birthday": {
      "type": "object",
      "properties": {
        "day": { "type": "string" },
        "month": { "type": "string" }
      }
    },

    "Metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "last_ai_update": { "type": ["string", "null"], "format": "date-time" },
        "completeness_score": { "type": "number" }
      }
    }
  }
}